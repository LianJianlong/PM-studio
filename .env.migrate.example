# Initialize a NEW database only. Never point this example at an existing system.
RUN_MIGRATIONS=true
DATABASE_URL=postgresql://studio:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/project_studio
APP_DB_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_ADMIN_PASSWORD
SYSTEM_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_SYSTEM_ADMIN_PASSWORD
ENCRYPTION_KEY=REPLACE_WITH_SAME_64_HEX_KEY_AS_RUNTIME
SEED_DEMO=false

